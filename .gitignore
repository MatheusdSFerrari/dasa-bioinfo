
# ==========================================
# Dasa Bioinfo - .gitignore
# ==========================================

# Dados de entrada e resultados
# Mantém as pastas, mas ignora seu conteúdo
/data/input/*
/data/output/*

# Permite versionar os diretórios vazios
!/data/input/.gitkeep
!/data/output/.gitkeep

# Arquivos genômicos
*.vcf
*.vcf.gz
*.gvcf
*.bam
*.bai
*.cram
*.crai
*.bcf
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.pod5

# Arquivo GENCODE original
# As partes gencode.part-* são versionadas
/references/gencode.v50.annotation.gtf.gz

# Arquivos de resultados e temporários
*.tsv
*.csv
*.log
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Configurações locais
.vscode/
.idea/
.env
.env.*
.DS_Store
Thumbs.db

# Metadados do Windows
*:Zone.Identifier
